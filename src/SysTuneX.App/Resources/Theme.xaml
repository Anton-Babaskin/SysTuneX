<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime"
                    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">

    <!--
        Design tokens.

        Everything below resolves through DynamicResource against the WPF UI theme dictionary, so
        the whole app follows the Windows light/dark setting. The previous build hard-coded
        colours like #99FFFFFF, which meant grey-on-white text the moment anyone used light mode.
    -->

    <!-- Spacing scale: 4 / 8 / 12 / 16 / 20 / 24 -->
    <Thickness x:Key="PagePadding">28,20,28,28</Thickness>
    <Thickness x:Key="CardPadding">20</Thickness>
    <Thickness x:Key="CardPaddingCompact">16,14</Thickness>
    <Thickness x:Key="StackGap">0,0,0,12</Thickness>
    <Thickness x:Key="SectionGap">0,0,0,20</Thickness>

    <!--
        The band a card gives its chart, at the bottom and bleeding to the card's edges. Named
        rather than repeated so the three monitor cards and the dashboard cannot drift apart, and
        so changing how much room a chart gets is one edit.
    -->
    <GridLength x:Key="ChartBandHeight">56</GridLength>

    <CornerRadius x:Key="CardCornerRadius">8</CornerRadius>
    <CornerRadius x:Key="PillCornerRadius">10</CornerRadius>

    <sys:Double x:Key="MaxContentWidth">1180</sys:Double>

    <!-- Risk accents. Defined as brushes rather than per-control colours so the risk pill,
         the tweak row border and the dialog header always agree. -->
    <SolidColorBrush x:Key="RiskSafeBrush" Color="#16A34A" />
    <SolidColorBrush x:Key="RiskSafeBackgroundBrush" Color="#2216A34A" />
    <SolidColorBrush x:Key="RiskModerateBrush" Color="#D97706" />
    <SolidColorBrush x:Key="RiskModerateBackgroundBrush" Color="#22D97706" />
    <SolidColorBrush x:Key="RiskAdvancedBrush" Color="#DC2626" />
    <SolidColorBrush x:Key="RiskAdvancedBackgroundBrush" Color="#22DC2626" />

    <SolidColorBrush x:Key="BrandBrush" Color="#7C5CFF" />
    <SolidColorBrush x:Key="BrandSecondaryBrush" Color="#22B8E6" />

    <LinearGradientBrush x:Key="BrandGradientBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#8B5CF6" Offset="0" />
        <GradientStop Color="#605CF6" Offset="0.5" />
        <GradientStop Color="#22B8E6" Offset="1" />
    </LinearGradientBrush>

    <!-- ── Typography ──────────────────────────────────────────────────────── -->

    <Style x:Key="PageTitle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="30" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
        <Setter Property="TextOptions.TextFormattingMode" Value="Ideal" />
    </Style>

    <Style x:Key="PageSubtitle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Margin" Value="0,4,0,0" />
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style x:Key="SectionTitle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="16" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
    </Style>

    <Style x:Key="BodyText" TargetType="TextBlock">
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style x:Key="CaptionText" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorTertiaryBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style x:Key="MetricValue" TargetType="TextBlock">
        <Setter Property="FontSize" Value="28" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
        <!-- Tabular figures stop live counters shifting width every time a digit changes. -->
        <Setter Property="TextOptions.TextFormattingMode" Value="Ideal" />
    </Style>

    <Style x:Key="MetricUnit" TargetType="TextBlock">
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Margin" Value="3,0,0,4" />
        <Setter Property="VerticalAlignment" Value="Bottom" />
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorTertiaryBrush}" />
    </Style>

    <!--
        A second reading beside the headline one - a temperature next to a load, a total next to
        a used figure. Deliberately smaller: two numbers at the same size read as equally
        important, and on the monitor page they are not. The load is what the page is about and
        the temperature is context for it.
    -->
    <Style x:Key="MetricValueSecondary" TargetType="TextBlock" BasedOn="{StaticResource MetricValue}">
        <Setter Property="FontSize" Value="20" />
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
    </Style>

    <!--
        Says which reading a number is. Without it "8 % 28°C" asks the reader to remember that the
        first figure is load and the second is temperature, every time they glance at the page -
        which is the opposite of what a glanceable page is for.
    -->
    <Style x:Key="MetricCaption" TargetType="TextBlock">
        <Setter Property="FontSize" Value="11" />
        <Setter Property="Margin" Value="0,-2,0,0" />
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorTertiaryBrush}" />
    </Style>

    <Style x:Key="MonoText" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="Cascadia Mono, Consolas, monospace" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>

    <!-- ── Surfaces ────────────────────────────────────────────────────────── -->

    <Style x:Key="Card" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorDefaultBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource CardCornerRadius}" />
        <Setter Property="Padding" Value="{StaticResource CardPadding}" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
    </Style>

    <Style x:Key="SubtleCard" TargetType="Border" BasedOn="{StaticResource Card}">
        <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorSecondaryBrush}" />
        <Setter Property="Padding" Value="{StaticResource CardPaddingCompact}" />
    </Style>

    <!-- A row that lifts slightly on hover, used for tweak and service lists. -->
    <Style x:Key="InteractiveCard" TargetType="Border" BasedOn="{StaticResource Card}">
        <Setter Property="Padding" Value="{StaticResource CardPaddingCompact}" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorSecondaryBrush}" />
                <Setter Property="BorderBrush" Value="{DynamicResource ControlStrokeColorSecondaryBrush}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="Pill" TargetType="Border">
        <Setter Property="CornerRadius" Value="{StaticResource PillCornerRadius}" />
        <Setter Property="Padding" Value="8,2" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
    </Style>

    <Style x:Key="PillText" TargetType="TextBlock">
        <Setter Property="FontSize" Value="11" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style x:Key="Divider" TargetType="Border">
        <Setter Property="Height" Value="1" />
        <Setter Property="Background" Value="{DynamicResource DividerStrokeColorDefaultBrush}" />
        <Setter Property="Margin" Value="0,12" />
    </Style>

    <!-- ── Controls ────────────────────────────────────────────────────────── -->

    <!-- FilterToggle lives in App.xaml: it derives from the WPF UI ToggleButton style, and a
         StaticResource inside a merged dictionary can only see that dictionary's own scope. -->

</ResourceDictionary>
