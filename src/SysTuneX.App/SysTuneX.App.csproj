<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <!--
        For the tray icon only. WPF UI 4 dropped its NotifyIcon, and hand-rolling Shell_NotifyIcon
        means owning a message window and re-registering on WM_TASKBARCREATED - which matters here
        more than usual, because restarting Explorer is one of SysTuneX's own features and would
        otherwise silently drop the icon. WinForms already handles all of it.
    -->
    <UseWindowsForms>true</UseWindowsForms>
    <!--
        WFO0003 tells WinForms apps to move DPI settings out of the manifest. This is a WPF app:
        WPF reads per-monitor awareness from the manifest and has no SetHighDpiMode equivalent,
        so following the advice would break DPI handling to satisfy an analyser for a framework
        that is only here for the tray icon.
    -->
    <NoWarn>$(NoWarn);WFO0003</NoWarn>
    <RootNamespace>SysTuneX.App</RootNamespace>
    <AssemblyName>SysTuneX</AssemblyName>
    <Description>SysTuneX — Windows 11 performance and latency tuner</Description>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\SysTuneX.ico</ApplicationIcon>
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <PublishReadyToRun>true</PublishReadyToRun>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <!-- WPF cannot be trimmed, so a self-contained build is inherently large.
         Compressing the bundle roughly halves the download for a small start-up cost. -->
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <EnableDefaultApplicationDefinition>false</EnableDefaultApplicationDefinition>
    <DebugType>embedded</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <ApplicationDefinition Include="App.xaml" SubType="Designer" Generator="MSBuild:Compile" />
  </ItemGroup>

  <ItemGroup>
    <!--
        UseWindowsForms adds these as implicit usings, and every one of them collides with a WPF
        type of the same name - Application, Control, Brush. The tray service asks for them by
        alias instead, so the rest of the app stays unambiguously WPF.
    -->
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>

  <ItemGroup>
    <!--
        The SDK globs **/*.xaml into Page, but it has no default glob for images: a .png sitting
        in the project is a None item and never reaches the assembly. Without this line the
        pack://application:,,,/Assets/SysTuneX.png reference in MainWindow.xaml resolves to
        nothing and ImageSourceConverter throws while the window's BAML loads, which WPF reports
        as "Provide value on 'TypeConverterMarkupExtension' threw an exception" - the app dies
        before it draws a pixel. AssemblyResourceTests keeps this honest.
    -->
    <Resource Include="Assets/SysTuneX.png" />
    <Resource Include="Assets/SysTuneX.ico" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\SysTuneX.Core\SysTuneX.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="WPF-UI" Version="4.3.0" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.11" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Update="Resources\Strings.resx">
      <Generator></Generator>
    </EmbeddedResource>
  </ItemGroup>

</Project>
