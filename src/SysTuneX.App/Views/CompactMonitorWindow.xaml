<Window x:Class="SysTuneX.App.Views.CompactMonitorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:loc="clr-namespace:SysTuneX.App.Localization"
        xmlns:vm="clr-namespace:SysTuneX.App.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:CompactMonitorViewModel}"
        Title="SysTuneX"
        SizeToContent="WidthAndHeight"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        Topmost="True"
        ShowInTaskbar="False"
        ShowActivated="False">

    <!--
        A normal window, deliberately. It floats above other windows and it can be dragged, but it
        is not an overlay: nothing is injected into the game and nothing hooks its presentation.
        That means it cannot draw over a game running in exclusive full screen - borderless window
        mode is what it is for - and that limit is the price of never tripping an anti-cheat.
    -->
    <Border CornerRadius="10"
            Background="{DynamicResource ApplicationBackgroundBrush}"
            BorderBrush="{DynamicResource ControlElevationBorderBrush}"
            BorderThickness="1"
            Padding="12,8">

        <StackPanel>

            <!-- The grab handle and the way out. Everything here is reachable with one hand. -->
            <Grid Margin="0,0,0,6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <ui:SymbolIcon Symbol="ReOrderDotsVertical24"
                               FontSize="14"
                               VerticalAlignment="Center"
                               Foreground="{DynamicResource TextFillColorTertiaryBrush}" />

                <TextBlock Grid.Column="1"
                           Text="{Binding GameName}"
                           Margin="6,0,8,0"
                           VerticalAlignment="Center"
                           MaxWidth="160"
                           TextTrimming="CharacterEllipsis"
                           FontSize="11"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />

                <ui:Button Grid.Column="2"
                           Icon="{ui:SymbolIcon Dismiss16}"
                           Appearance="Secondary"
                           Padding="4"
                           FontSize="11"
                           ToolTip="{loc:Loc Compact_Close}"
                           Click="OnCloseClicked" />
            </Grid>

            <ItemsControl ItemsSource="{Binding Tiles}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <!--
                            One row that wraps. The readout is between one and twelve tiles wide
                            depending on what is ticked, and a fixed column count would either
                            waste half the strip or force it off the edge of the screen.
                        -->
                        <WrapPanel Orientation="Horizontal" MaxWidth="440" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>

                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Margin="0,0,16,4" MinWidth="52">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding Value}"
                                           FontSize="19"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                <TextBlock Text="{Binding Unit}"
                                           FontSize="10"
                                           Margin="2,0,0,3"
                                           VerticalAlignment="Bottom"
                                           Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                            </StackPanel>
                            <TextBlock Text="{Binding Label}"
                                       FontSize="10"
                                       TextTrimming="CharacterEllipsis"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- Better than an empty box the user cannot tell from a broken one. -->
            <TextBlock Text="{loc:Loc Compact_Empty}"
                       FontSize="11"
                       MaxWidth="200"
                       TextWrapping="Wrap"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                       Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibility}}" />

        </StackPanel>
    </Border>
</Window>
