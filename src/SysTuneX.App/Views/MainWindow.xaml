<ui:FluentWindow x:Class="SysTuneX.App.Views.MainWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:loc="clr-namespace:SysTuneX.App.Localization"
                 xmlns:pages="clr-namespace:SysTuneX.App.Views.Pages"
                 xmlns:vm="clr-namespace:SysTuneX.App.ViewModels"
                 xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                 mc:Ignorable="d"
                 d:DataContext="{d:DesignInstance Type=vm:MainWindowViewModel}"
                 Title="SysTuneX"
                 Width="1240" Height="800"
                 MinWidth="960" MinHeight="640"
                 WindowStartupLocation="CenterScreen"
                 ExtendsContentIntoTitleBar="True"
                 WindowCornerPreference="Round"
                 WindowBackdropType="Mica">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!--
            The title bar is a sibling of the content, not an overlay nested inside
            NavigationView. Nesting it there, as the previous version did, left the window
            with no working drag region and no way to move it.
        -->
        <ui:TitleBar Grid.Row="0"
                     Title="{Binding ApplicationTitle, Mode=OneWay}"
                     ShowMaximize="True"
                     ShowMinimize="True"
                     ShowClose="True">
            <ui:TitleBar.Icon>
                <ui:ImageIcon Source="pack://application:,,,/SysTuneX;component/Assets/SysTuneX.png" Width="18" Height="18" />
            </ui:TitleBar.Icon>
        </ui:TitleBar>

        <!-- Banners describe the state of the whole app, so they sit above every page rather
             than being repeated on each one. The row collapses to nothing when all are closed. -->
        <StackPanel Grid.Row="1" Margin="16,4,16,0">
            <ui:InfoBar Severity="Error"
                        IsClosable="False"
                        Margin="0,0,0,8"
                        Title="{loc:Loc Banner_NotElevated_Title}"
                        Message="{loc:Loc Banner_NotElevated_Message}"
                        IsOpen="{Binding IsElevated, Converter={StaticResource InverseBool}, Mode=OneWay}">
                <ui:Button Content="{loc:Loc Banner_NotElevated_Action}"
                           Appearance="Primary"
                           HorizontalAlignment="Left"
                           Margin="0,8,0,4"
                           Command="{Binding RestartElevatedCommand}" />
            </ui:InfoBar>

            <ui:InfoBar Severity="Warning"
                        IsClosable="False"
                        Margin="0,0,0,8"
                        Title="{loc:Loc Banner_UnsupportedOs_Title}"
                        Message="{loc:Loc Banner_UnsupportedOs_Message}"
                        IsOpen="{Binding IsOsSupported, Converter={StaticResource InverseBool}, Mode=OneWay}" />

            <ui:InfoBar Severity="Informational"
                        Margin="0,0,0,8"
                        Title="{loc:Loc Banner_RestartRequired_Title}"
                        Message="{loc:Loc Banner_RestartRequired_Message}"
                        IsOpen="{Binding IsRestartPending, Mode=TwoWay}">
                <ui:Button Content="{loc:Loc Common_RestartNow}"
                           HorizontalAlignment="Left"
                           Margin="0,8,0,4"
                           Command="{Binding RestartWindowsCommand}" />
            </ui:InfoBar>
        </StackPanel>

        <Grid Grid.Row="2">
            <ui:NavigationView x:Name="RootNavigation"
                               PaneDisplayMode="Left"
                               OpenPaneLength="240"
                               IsBackButtonVisible="Collapsed"
                               IsPaneToggleVisible="True"
                               TransitionDuration="180">

                <!-- One search across every page. Knowing which page a setting lives on is the
                     app's problem, not the user's. -->
                <ui:NavigationView.AutoSuggestBox>
                    <ui:AutoSuggestBox x:Name="SearchBox"
                                       PlaceholderText="{loc:Loc Search_Placeholder}"
                                       QuerySubmitted="OnSearchSubmitted"
                                       SuggestionChosen="OnSearchSuggestionChosen"
                                       TextChanged="OnSearchTextChanged" />
                </ui:NavigationView.AutoSuggestBox>

                <ui:NavigationView.MenuItems>
                    <ui:NavigationViewItem Content="{loc:Loc Nav_Dashboard}"
                                           NavigationCacheMode="Enabled"
                                           TargetPageType="{x:Type pages:DashboardPage}">
                        <ui:NavigationViewItem.Icon>
                            <ui:SymbolIcon Symbol="Gauge24" />
                        </ui:NavigationViewItem.Icon>
                    </ui:NavigationViewItem>

                    <ui:NavigationViewItem Content="{loc:Loc Nav_Profiles}"
                                           NavigationCacheMode="Enabled"
                                           TargetPageType="{x:Type pages:ProfilesPage}">
                        <ui:NavigationViewItem.Icon>
                            <ui:SymbolIcon Symbol="Rocket24" />
                        </ui:NavigationViewItem.Icon>
                    </ui:NavigationViewItem>

                    <ui:NavigationViewItem Content="{loc:Loc Nav_Monitor}"
                                           NavigationCacheMode="Enabled"
                                           TargetPageType="{x:Type pages:MonitorPage}">
                        <ui:NavigationViewItem.Icon>
                            <ui:SymbolIcon Symbol="Pulse24" />
                        </ui:NavigationViewItem.Icon>
                    </ui:NavigationViewItem>

                    <ui:NavigationViewItemSeparator />

                    <ui:NavigationViewItem Content="{loc:Loc Nav_Gaming}"
                                           NavigationCacheMode="Enabled"
                                           TargetPageType="{x:Type pages:GamingPage}">
                        <ui:NavigationViewItem.Icon>
                            <ui:SymbolIcon Symbol="XboxController24" />
                        </ui:NavigationViewItem.Icon>
                    </ui:NavigationViewItem>

                    <ui:NavigationViewItem Content="{loc:Loc Nav_Windows11}"
                                           NavigationCacheMode="Enabled"
                                           TargetPageType="{x:Type pages:Windows11Page}">
                        <ui:NavigationViewItem.Icon>
                            <ui:SymbolIcon Symbol="Desktop24" />
                        </ui:NavigationViewItem.Icon>
                    </ui:NavigationViewItem>

                    <ui:NavigationViewItem Content="{loc:Loc Nav_Services}"
                                           NavigationCacheMode="Enabled"
                                           TargetPageType="{x:Type pages:ServicesPage}">
                        <ui:NavigationViewItem.Icon>
                            <ui:SymbolIcon Symbol="Server24" />
                        </ui:NavigationViewItem.Icon>
                    </ui:NavigationViewItem>

                    <ui:NavigationViewItem Content="{loc:Loc Nav_Privacy}"
                                           NavigationCacheMode="Enabled"
                                           TargetPageType="{x:Type pages:PrivacyPage}">
                        <ui:NavigationViewItem.Icon>
                            <ui:SymbolIcon Symbol="ShieldCheckmark24" />
                        </ui:NavigationViewItem.Icon>
                    </ui:NavigationViewItem>

                    <ui:NavigationViewItem Content="{loc:Loc Nav_Network}"
                                           NavigationCacheMode="Enabled"
                                           TargetPageType="{x:Type pages:NetworkPage}">
                        <ui:NavigationViewItem.Icon>
                            <ui:SymbolIcon Symbol="Wifi124" />
                        </ui:NavigationViewItem.Icon>
                    </ui:NavigationViewItem>

                    <ui:NavigationViewItem Content="{loc:Loc Nav_Cleanup}"
                                           NavigationCacheMode="Enabled"
                                           TargetPageType="{x:Type pages:CleanupPage}">
                        <ui:NavigationViewItem.Icon>
                            <ui:SymbolIcon Symbol="Broom24" />
                        </ui:NavigationViewItem.Icon>
                    </ui:NavigationViewItem>
                </ui:NavigationView.MenuItems>

                <ui:NavigationView.FooterMenuItems>
                    <ui:NavigationViewItem Content="{loc:Loc Nav_History}"
                                           NavigationCacheMode="Enabled"
                                           TargetPageType="{x:Type pages:HistoryPage}">
                        <ui:NavigationViewItem.Icon>
                            <ui:SymbolIcon Symbol="History24" />
                        </ui:NavigationViewItem.Icon>
                    </ui:NavigationViewItem>

                    <ui:NavigationViewItem Content="{loc:Loc Nav_Settings}"
                                           NavigationCacheMode="Enabled"
                                           TargetPageType="{x:Type pages:SettingsPage}">
                        <ui:NavigationViewItem.Icon>
                            <ui:SymbolIcon Symbol="Settings24" />
                        </ui:NavigationViewItem.Icon>
                    </ui:NavigationViewItem>
                </ui:NavigationView.FooterMenuItems>
            </ui:NavigationView>

            <!-- Dialog and snackbar hosts float above the page content. The wrapper is
                 hit-test transparent so the page underneath stays clickable. -->
            <Grid IsHitTestVisible="False">
                <ui:ContentDialogHost x:Name="DialogHost" IsHitTestVisible="True" />
                <ui:SnackbarPresenter x:Name="SnackbarHost"
                                      IsHitTestVisible="True"
                                      VerticalAlignment="Bottom"
                                      HorizontalAlignment="Center"
                                      Margin="0,0,0,24" />
            </Grid>
        </Grid>
    </Grid>
</ui:FluentWindow>
