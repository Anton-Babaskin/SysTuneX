<pages:SysTuneXPage x:Class="SysTuneX.App.Views.Pages.MonitorPage"
                    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                    xmlns:loc="clr-namespace:SysTuneX.App.Localization"
                    xmlns:pages="clr-namespace:SysTuneX.App.Views.Pages"
                    xmlns:controls="clr-namespace:SysTuneX.App.Controls"
                    xmlns:vm="clr-namespace:SysTuneX.App.ViewModels"
                    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                    mc:Ignorable="d"
                    d:DataContext="{d:DesignInstance Type=vm:MonitorViewModel}"
                    Title="Monitor">

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="{StaticResource PagePadding}">
        <StackPanel MaxWidth="{StaticResource MaxContentWidth}" HorizontalAlignment="Left">

            <StackPanel Margin="{StaticResource SectionGap}">
                <TextBlock Text="{loc:Loc Monitor_Title}" Style="{StaticResource PageTitle}" />
                <TextBlock Text="{loc:Loc Monitor_Subtitle}" Style="{StaticResource PageSubtitle}" />
            </StackPanel>

            <!--
                What to measure. Folded away because it is set once and left alone - but the frame
                counter's switch sits on the header row, since that is the one control people reach
                for repeatedly and it should not need the panel opened first.
            -->
            <ui:CardExpander Icon="{ui:SymbolIcon Options24}" Margin="{StaticResource StackGap}" IsExpanded="False">
                <ui:CardExpander.Header>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="{loc:Loc Monitor_Settings}" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                            <TextBlock Text="{Binding Preview}"
                                       Style="{StaticResource MonoText}"
                                       Margin="0,2,12,0"
                                       TextTrimming="CharacterEllipsis" />
                        </StackPanel>

                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"
                                    Margin="0,0,12,0">
                            <ui:ProgressRing IsIndeterminate="True" Width="18" Height="18" Margin="0,0,10,0"
                                             Visibility="{Binding FrameCounterStarting, Converter={StaticResource BoolToVisibility}}" />
                            <TextBlock Text="{loc:Loc Monitor_FrameCounter}" Style="{StaticResource CaptionText}"
                                       VerticalAlignment="Center" Margin="0,0,8,0" />
                            <ui:ToggleSwitch IsChecked="{Binding FrameCounterEnabled, Mode=TwoWay}" />
                        </StackPanel>
                    </Grid>
                </ui:CardExpander.Header>

                <StackPanel>
                    <TextBlock Text="{loc:Loc Monitor_FrameCounter_Hint}"
                               Style="{StaticResource BodyText}"
                               Margin="0,0,0,12" />

                    <CheckBox Content="{loc:Loc Monitor_KeepInBackground}"
                              IsChecked="{Binding KeepFrameCounterInBackground, Mode=TwoWay}"
                              IsEnabled="{Binding FrameCounterEnabled}"
                              Margin="0,0,0,4" />
                    <TextBlock Text="{loc:Loc Monitor_KeepInBackground_Hint}"
                               Style="{StaticResource CaptionText}"
                               Margin="28,0,0,16" />

                    <Border Style="{StaticResource Divider}" />

                    <Grid Margin="0,0,0,10">
                        <TextBlock Text="{loc:Loc Monitor_Settings_Readings}" Style="{StaticResource CaptionText}" />
                        <!-- The cap, visible before it is reached rather than only when it refuses. -->
                        <TextBlock Text="{Binding SelectionCount}"
                                   Style="{StaticResource CaptionText}"
                                   HorizontalAlignment="Right" />
                    </Grid>

                    <ItemsControl ItemsSource="{Binding GroupedOptions}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:MonitorMetricOption}">
                                <CheckBox Content="{Binding Name}"
                                          IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                          IsEnabled="{Binding CanToggle}"
                                          Margin="0,0,20,8" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>

                        <ItemsControl.GroupStyle>
                            <GroupStyle>
                                <GroupStyle.ContainerStyle>
                                    <Style TargetType="GroupItem">
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="GroupItem">
                                                    <StackPanel Margin="0,0,0,10">
                                                        <TextBlock Text="{Binding Name}"
                                                                   FontWeight="SemiBold"
                                                                   Margin="0,0,0,6"
                                                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                                        <ItemsPresenter />
                                                    </StackPanel>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </GroupStyle.ContainerStyle>
                                <GroupStyle.Panel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel Orientation="Horizontal" />
                                    </ItemsPanelTemplate>
                                </GroupStyle.Panel>
                            </GroupStyle>
                        </ItemsControl.GroupStyle>
                    </ItemsControl>

                    <TextBlock Text="{loc:Loc Monitor_Settings_Cost}"
                               Style="{StaticResource CaptionText}"
                               Margin="0,8,0,0" />
                </StackPanel>
            </ui:CardExpander>

            <ui:InfoBar Severity="Informational"
                        IsOpen="{Binding ShowNothing, Mode=OneWay}"
                        IsClosable="False"
                        Margin="{StaticResource StackGap}"
                        Title="{loc:Loc Monitor_Empty_Title}"
                        Message="{loc:Loc Monitor_Empty_Message}" />

            <!--
                Frame rate, given the whole width and the largest type on the page. It is the one
                number someone opens this page to read; everything below it exists to explain it.
            -->
            <Border Style="{StaticResource Card}" Margin="{StaticResource StackGap}"
                    Visibility="{Binding ShowFrameCard, Converter={StaticResource BoolToVisibility}}">
                <Grid Height="148">
                    <controls:Sparkline Values="{Binding FpsHistory}"
                                        Maximum="{Binding FpsScale}"
                                        Capacity="60"
                                        Margin="-20,84,-20,-20"
                                        Stroke="{StaticResource BrandBrush}"
                                        Fill="#227C5CFF" />

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel VerticalAlignment="Top">
                            <TextBlock Text="{loc:Loc Monitor_FrameRate}" Style="{StaticResource CaptionText}" />

                            <StackPanel Orientation="Horizontal"
                                        Visibility="{Binding DisplayFps, Converter={StaticResource BoolToVisibility}}">
                                <TextBlock Text="{Binding Fps}"
                                           FontSize="64"
                                           FontWeight="SemiBold"
                                           LineHeight="70"
                                           Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                <TextBlock Text="FPS"
                                           FontSize="16"
                                           Margin="8,0,0,14"
                                           VerticalAlignment="Bottom"
                                           Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                            </StackPanel>

                            <TextBlock Text="{Binding GameName}"
                                       FontSize="14"
                                       Margin="0,2,0,0"
                                       TextTrimming="CharacterEllipsis"
                                       Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"
                                       Visibility="{Binding HasFrameRate, Converter={StaticResource BoolToVisibility}}" />

                            <!-- No number is not an error. Say which of the two reasons it is. -->
                            <TextBlock Text="{Binding FrameRateHint}"
                                       Style="{StaticResource BodyText}"
                                       MaxWidth="420"
                                       Margin="0,10,0,0"
                                       HorizontalAlignment="Left"
                                       Visibility="{Binding HasFrameRate, Converter={StaticResource InverseBoolToVisibility}}" />
                        </StackPanel>

                        <StackPanel Grid.Column="2" VerticalAlignment="Top" MinWidth="150">
                            <!--
                                The 1% low sits next to the average because on its own the average
                                lies. 144 with a 1% low of 40 stutters; a steady 90 does not.
                            -->
                            <StackPanel Visibility="{Binding DisplayOnePercentLow, Converter={StaticResource BoolToVisibility}}">
                                <TextBlock Text="{loc:Loc Monitor_OnePercentLow}" Style="{StaticResource CaptionText}" />
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding OnePercentLowFps}" Style="{StaticResource MetricValue}" />
                                    <TextBlock Text="FPS" Style="{StaticResource MetricUnit}" />
                                </StackPanel>
                            </StackPanel>

                            <StackPanel Margin="0,12,0,0"
                                        Visibility="{Binding DisplayFrameTime, Converter={StaticResource BoolToVisibility}}">
                                <TextBlock Text="{loc:Loc Monitor_FrameTime}" Style="{StaticResource CaptionText}" />
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding FrameTimeMs, StringFormat={}{0:F1}}"
                                               Style="{StaticResource MetricValue}" />
                                    <TextBlock Text="ms" Style="{StaticResource MetricUnit}" />
                                </StackPanel>
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>

            <!--
                What the machine is doing while it renders that. Columns bound to the visible count:
                a UniformGrid ignores collapsed children, so the cards on screen fill the width
                instead of leaving a gap where a switched-off one used to be.
            -->
            <UniformGrid Columns="{Binding VisibleCardCount}" Margin="-3,0">

                <Border Style="{StaticResource Card}" Margin="3,0"
                        Visibility="{Binding ShowCpuCard, Converter={StaticResource BoolToVisibility}}">
                    <Grid Height="110">
                        <controls:Sparkline Values="{Binding CpuHistory}"
                                            Maximum="100"
                                            Capacity="60"
                                            Margin="-20,52,-20,-20"
                                            Stroke="{StaticResource BrandBrush}"
                                            Fill="#227C5CFF" />

                        <StackPanel VerticalAlignment="Top">
                            <TextBlock Text="{loc:Loc Monitor_Cpu}" Style="{StaticResource CaptionText}" />
                            <StackPanel Orientation="Horizontal">
                                <StackPanel Orientation="Horizontal"
                                            Visibility="{Binding DisplayCpuLoad, Converter={StaticResource BoolToVisibility}}">
                                    <TextBlock Text="{Binding CpuUsage, StringFormat={}{0:F0}}"
                                               Style="{StaticResource MetricValue}" />
                                    <TextBlock Text="%" Style="{StaticResource MetricUnit}" />
                                </StackPanel>

                                <TextBlock Style="{StaticResource MetricValue}"
                                           FontSize="18"
                                           Margin="14,0,0,3"
                                           VerticalAlignment="Bottom"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                           Visibility="{Binding DisplayCpuTemperature, Converter={StaticResource BoolToVisibility}}">
                                    <Run Text="{Binding CpuTemperature, Mode=OneWay}" /><Run Text="°C" />
                                </TextBlock>
                            </StackPanel>
                            <TextBlock Text="{Binding CpuName}"
                                       Style="{StaticResource CaptionText}"
                                       TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </Grid>
                </Border>

                <Border Style="{StaticResource Card}" Margin="3,0"
                        Visibility="{Binding ShowGpuCard, Converter={StaticResource BoolToVisibility}}">
                    <Grid Height="110">
                        <controls:Sparkline Values="{Binding GpuHistory}"
                                            Maximum="100"
                                            Capacity="60"
                                            Margin="-20,52,-20,-20"
                                            Stroke="{StaticResource BrandSecondaryBrush}"
                                            Fill="#2222B8E6" />

                        <StackPanel VerticalAlignment="Top">
                            <TextBlock Text="{loc:Loc Monitor_Gpu}" Style="{StaticResource CaptionText}" />

                            <StackPanel Orientation="Horizontal">
                                <!-- Load and temperature share a line: a hot card at 40% and a hot
                                     card at 99% mean completely different things. -->
                                <StackPanel Orientation="Horizontal"
                                            Visibility="{Binding DisplayGpuLoad, Converter={StaticResource BoolToVisibility}}">
                                    <TextBlock Text="{Binding GpuUsage}" Style="{StaticResource MetricValue}" />
                                    <TextBlock Text="%" Style="{StaticResource MetricUnit}" />
                                </StackPanel>

                                <TextBlock Style="{StaticResource MetricValue}"
                                           FontSize="18"
                                           Margin="14,0,0,3"
                                           VerticalAlignment="Bottom"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                           Visibility="{Binding DisplayGpuTemperature, Converter={StaticResource BoolToVisibility}}">
                                    <Run Text="{Binding GpuTemperature, Mode=OneWay}" /><Run Text="°C" />
                                </TextBlock>

                                <TextBlock Style="{StaticResource MetricValue}"
                                           FontSize="18"
                                           Margin="14,0,0,3"
                                           VerticalAlignment="Bottom"
                                           Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                           Visibility="{Binding DisplayGpuFan, Converter={StaticResource BoolToVisibility}}">
                                    <Run Text="{Binding GpuFan, Mode=OneWay}" /><Run Text="%" />
                                </TextBlock>
                            </StackPanel>

                            <TextBlock Text="{Binding GpuName}"
                                       Style="{StaticResource CaptionText}"
                                       TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </Grid>
                </Border>

                <Border Style="{StaticResource Card}" Margin="3,0"
                        Visibility="{Binding ShowMemoryCard, Converter={StaticResource BoolToVisibility}}">
                    <Grid Height="110">
                        <controls:Sparkline Values="{Binding RamHistory}"
                                            Maximum="100"
                                            Capacity="60"
                                            Margin="-20,52,-20,-20"
                                            Stroke="{StaticResource BrandSecondaryBrush}"
                                            Fill="#2222B8E6" />

                        <StackPanel VerticalAlignment="Top">
                            <TextBlock Text="{loc:Loc Monitor_Memory}" Style="{StaticResource CaptionText}" />

                            <StackPanel Orientation="Horizontal"
                                        Visibility="{Binding DisplayMemory, Converter={StaticResource BoolToVisibility}}">
                                <TextBlock Text="{Binding RamUsedMb, Converter={StaticResource MegabytesToSize}}"
                                           Style="{StaticResource MetricValue}" />
                                <TextBlock Style="{StaticResource MetricUnit}">
                                    <Run Text="{loc:Loc Common_Of}" /><Run Text=" " /><Run Text="{Binding RamTotalMb, Converter={StaticResource MegabytesToSize}, Mode=OneWay}" />
                                </TextBlock>
                            </StackPanel>

                            <TextBlock Style="{StaticResource CaptionText}"
                                       Visibility="{Binding DisplayStandby, Converter={StaticResource BoolToVisibility}}">
                                <Run Text="{loc:Loc Metric_StandbyMemory}" /><Run Text=": " /><Run Text="{Binding StandbyMb, Converter={StaticResource MegabytesToSize}, Mode=OneWay}" />
                            </TextBlock>

                            <TextBlock Style="{StaticResource CaptionText}"
                                       Visibility="{Binding DisplayDiskFree, Converter={StaticResource BoolToVisibility}}">
                                <Run Text="{loc:Loc Metric_DiskFree}" /><Run Text=": " /><Run Text="{Binding DriveFreeMb, Converter={StaticResource MegabytesToSize}, Mode=OneWay}" />
                            </TextBlock>

                            <TextBlock Style="{StaticResource CaptionText}"
                                       Visibility="{Binding DisplayProcessCount, Converter={StaticResource BoolToVisibility}}">
                                <Run Text="{loc:Loc Monitor_Label_Processes}" />
                                <Run Text="{Binding ProcessCount, Mode=OneWay}" />
                            </TextBlock>

                            <TextBlock Style="{StaticResource CaptionText}"
                                       Visibility="{Binding DisplayUptime, Converter={StaticResource BoolToVisibility}}">
                                <Run Text="{loc:Loc Metric_Uptime}" /><Run Text=": " /><Run Text="{Binding Uptime, Converter={StaticResource TimeSpanToUptime}, Mode=OneWay}" />
                            </TextBlock>
                        </StackPanel>
                    </Grid>
                </Border>

            </UniformGrid>

            <!-- Only once every temperature that was asked for has come back empty, and then with
                 the reason: a blank where a temperature should be reads as a broken app. -->
            <TextBlock Text="{loc:Loc Dashboard_NoSensors}"
                       Style="{StaticResource CaptionText}"
                       Margin="0,14,0,0"
                       Visibility="{Binding HasNoTemperature, Converter={StaticResource BoolToVisibility}}" />

            <!--
                Said once, here, rather than as a disclaimer on every tile. Someone who wonders why
                there is no overlay deserves the real reason, and the reason is a good one.
            -->
            <ui:InfoBar Severity="Informational"
                        IsOpen="True"
                        IsClosable="True"
                        Margin="0,16,0,0"
                        Title="{loc:Loc Monitor_HowItWorks_Title}"
                        Message="{loc:Loc Monitor_HowItWorks_Message}" />

        </StackPanel>
    </ScrollViewer>
</pages:SysTuneXPage>
