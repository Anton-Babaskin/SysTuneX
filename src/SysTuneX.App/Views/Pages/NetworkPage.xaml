<pages:SysTuneXPage x:Class="SysTuneX.App.Views.Pages.NetworkPage"
                    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                    xmlns:loc="clr-namespace:SysTuneX.App.Localization"
                    xmlns:pages="clr-namespace:SysTuneX.App.Views.Pages"
                    xmlns:vm="clr-namespace:SysTuneX.App.ViewModels"
                    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                    mc:Ignorable="d"
                    d:DataContext="{d:DesignInstance Type=vm:NetworkViewModel}"
                    Title="Network">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="28,20,28,0"
                    MaxWidth="{StaticResource MaxContentWidth}"
                    HorizontalAlignment="Left">
            <Grid Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel>
                    <TextBlock Text="{loc:Loc Network_Title}" Style="{StaticResource PageTitle}" />
                    <TextBlock Text="{loc:Loc Network_Subtitle}" Style="{StaticResource PageSubtitle}" />
                </StackPanel>

                <ContentControl Grid.Column="1" Template="{StaticResource TweakToolbarTemplate}" />
            </Grid>

            <ContentControl Template="{StaticResource TweakFilterBarTemplate}" />
        </StackPanel>

        <Grid Grid.Row="1">
            <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="28,0,28,28">
                <Grid MaxWidth="{StaticResource MaxContentWidth}" HorizontalAlignment="Left">
                    <StackPanel>

                        <Border Style="{StaticResource Card}" Margin="0,0,0,20">
                            <StackPanel>
                                <TextBlock Text="{loc:Loc Network_Dns_Title}"
                                           Style="{StaticResource SectionTitle}"
                                           Margin="0,0,0,12" />

                                <TextBlock Text="{loc:Loc Network_NoAdapter}"
                                           Style="{StaticResource BodyText}"
                                           Visibility="{Binding HasAdapter, Converter={StaticResource InverseBoolToVisibility}}" />

                                <StackPanel Visibility="{Binding HasAdapter, Converter={StaticResource BoolToVisibility}}">
                                    <Grid Margin="0,0,0,14">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Margin="0,0,12,0">
                                            <TextBlock Text="{loc:Loc Network_Adapter}" Style="{StaticResource CaptionText}" />
                                            <ComboBox ItemsSource="{Binding Adapters}"
                                                      SelectedItem="{Binding SelectedAdapter}"
                                                      DisplayMemberPath="Name"
                                                      Margin="0,4,0,0"
                                                      HorizontalAlignment="Stretch" />
                                        </StackPanel>

                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="{loc:Loc Network_Dns_Current}" Style="{StaticResource CaptionText}" />
                                            <TextBlock Text="{Binding CurrentDns}"
                                                       Margin="0,8,0,0"
                                                       FontWeight="SemiBold"
                                                       TextWrapping="Wrap"
                                                       Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                        </StackPanel>
                                    </Grid>

                                    <ItemsControl ItemsSource="{Binding Presets}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <UniformGrid Columns="3" />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <RadioButton GroupName="DnsPreset"
                                                             Margin="0,0,10,10"
                                                             VerticalContentAlignment="Center"
                                                             IsChecked="{Binding IsSelected, Mode=OneWay}"
                                                             Command="{Binding DataContext.SelectPresetCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                                             CommandParameter="{Binding}">
                                                    <StackPanel>
                                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold"
                                                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                                        <TextBlock Text="{Binding Servers}" Style="{StaticResource CaptionText}" />
                                                        <TextBlock Text="{Binding LatencyText}"
                                                                   Style="{StaticResource CaptionText}"
                                                                   Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                                                    </StackPanel>
                                                </RadioButton>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                        <ui:Button Content="{loc:Loc Network_Dns_Apply}"
                                                   Appearance="Primary"
                                                   Margin="0,0,8,0"
                                                   Command="{Binding ApplyDnsCommand}" />

                                        <ui:Button Content="{loc:Loc Network_Dns_Reset}"
                                                   Margin="0,0,8,0"
                                                   Command="{Binding ResetDnsCommand}" />

                                        <ui:Button Content="{loc:Loc Network_Dns_Flush}"
                                                   Margin="0,0,8,0"
                                                   Command="{Binding FlushDnsCommand}" />

                                        <ui:Button Content="{loc:Loc Network_Measure}"
                                                   Icon="{ui:SymbolIcon Pulse24}"
                                                   Command="{Binding MeasureCommand}" />

                                        <TextBlock Text="{Binding Latency}"
                                                   VerticalAlignment="Center"
                                                   Margin="12,0,0,0"
                                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                    </StackPanel>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <ItemsControl ItemsSource="{Binding Groups}" ItemTemplate="{StaticResource TweakGroupTemplate}" />
                    </StackPanel>
                </Grid>
            </ScrollViewer>

            <ContentControl Template="{StaticResource BusyOverlayTemplate}" />
        </Grid>
    </Grid>
</pages:SysTuneXPage>
