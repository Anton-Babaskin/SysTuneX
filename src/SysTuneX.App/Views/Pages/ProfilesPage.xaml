<pages:SysTuneXPage x:Class="SysTuneX.App.Views.Pages.ProfilesPage"
                    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                    xmlns:loc="clr-namespace:SysTuneX.App.Localization"
                    xmlns:pages="clr-namespace:SysTuneX.App.Views.Pages"
                    xmlns:vm="clr-namespace:SysTuneX.App.ViewModels"
                    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                    mc:Ignorable="d"
                    d:DataContext="{d:DesignInstance Type=vm:ProfilesViewModel}"
                    Title="Profiles">

    <Grid>
        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="{StaticResource PagePadding}">
            <Grid MaxWidth="{StaticResource MaxContentWidth}" HorizontalAlignment="Left">
                <StackPanel>

                    <Grid Margin="{StaticResource SectionGap}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel>
                            <TextBlock Text="{loc:Loc Profiles_Title}" Style="{StaticResource PageTitle}" />
                            <TextBlock Text="{loc:Loc Profiles_Subtitle}" Style="{StaticResource PageSubtitle}" />
                        </StackPanel>

                        <ui:Button Grid.Column="1"
                                   Icon="{ui:SymbolIcon ArrowClockwise24}"
                                   ToolTip="{loc:Loc Common_Refresh}"
                                   VerticalAlignment="Top"
                                   Command="{Binding RefreshCommand}" />
                    </Grid>

                    <!-- Options that change what applying a profile is allowed to touch. -->
                    <Border Style="{StaticResource SubtleCard}" Margin="{StaticResource StackGap}">
                        <StackPanel>
                            <ui:ToggleSwitch IsChecked="{Binding IncludeAdvanced}"
                                             Content="{loc:Loc Profiles_IncludeAdvanced}" />
                            <TextBlock Text="{loc:Loc Profiles_IncludeAdvanced_Hint}"
                                       Style="{StaticResource CaptionText}"
                                       Margin="0,4,0,12" />

                            <ui:ToggleSwitch IsChecked="{Binding CreateRestorePoint}"
                                             IsEnabled="{Binding RestorePointAvailable}"
                                             Content="{loc:Loc Profiles_CreateRestorePoint}" />
                            <TextBlock Text="{loc:Loc Settings_RestorePoint_Hint}"
                                       Style="{StaticResource CaptionText}"
                                       Margin="0,4,0,0"
                                       Visibility="{Binding RestorePointAvailable, Converter={StaticResource InverseBoolToVisibility}}" />
                        </StackPanel>
                    </Border>

                    <ui:InfoBar Severity="Informational"
                                Margin="{StaticResource StackGap}"
                                Title="{loc:Loc Banner_RestartRequired_Title}"
                                Message="{loc:Loc Banner_RestartRequired_Message}"
                                IsOpen="{Binding RestartRequired, Mode=TwoWay}" />

                    <ItemsControl ItemsSource="{Binding Profiles}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Columns="2" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>

                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:ProfileCardViewModel}">
                                <Border Style="{StaticResource Card}" Margin="0,0,12,12">
                                    <StackPanel>
                                        <Grid Margin="0,0,0,10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <!-- Accent tile: the profile's colour is the only
                                                 thing distinguishing the cards at a glance. -->
                                            <Border Width="44" Height="44"
                                                    CornerRadius="10"
                                                    Margin="0,0,14,0"
                                                    Background="{Binding AccentColor, Converter={StaticResource HexToBrush}, ConverterParameter=soft}">
                                                <ui:SymbolIcon Symbol="{Binding Icon}"
                                                               FontSize="22"
                                                               HorizontalAlignment="Center"
                                                               VerticalAlignment="Center"
                                                               Foreground="{Binding AccentColor, Converter={StaticResource HexToBrush}}" />
                                            </Border>

                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Name}"
                                                           FontSize="16"
                                                           FontWeight="SemiBold"
                                                           Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                                <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                                                    <TextBlock Style="{StaticResource CaptionText}">
                                                        <Run Text="{Binding TweakCount, Mode=OneWay}" />
                                                        <Run Text="{loc:Loc Profiles_Tweaks}" />
                                                    </TextBlock>
                                                    <TextBlock Text="·" Style="{StaticResource CaptionText}" Margin="6,0" />
                                                    <TextBlock Style="{StaticResource CaptionText}">
                                                        <Run Text="{Binding ServiceCount, Mode=OneWay}" />
                                                        <Run Text="{loc:Loc Profiles_Services}" />
                                                    </TextBlock>
                                                </StackPanel>
                                            </StackPanel>

                                            <Border Grid.Column="2"
                                                    Style="{StaticResource Pill}"
                                                    VerticalAlignment="Top"
                                                    Background="{StaticResource RiskAdvancedBackgroundBrush}"
                                                    Visibility="{Binding HasAdvanced, Converter={StaticResource BoolToVisibility}}">
                                                <TextBlock Text="{loc:Loc Risk_Advanced}"
                                                           Style="{StaticResource PillText}"
                                                           Foreground="{StaticResource RiskAdvancedBrush}" />
                                            </Border>
                                        </Grid>

                                        <TextBlock Text="{Binding Description}"
                                                   Style="{StaticResource BodyText}"
                                                   MinHeight="56" />

                                        <StackPanel Margin="0,8,0,0"
                                                    Visibility="{Binding HasExampleGames, Converter={StaticResource BoolToVisibility}}">
                                            <TextBlock Text="{loc:Loc Profiles_ExampleGames}" Style="{StaticResource CaptionText}" />
                                            <ItemsControl ItemsSource="{Binding ExampleGames}" Margin="0,4,0,0">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <WrapPanel />
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border Style="{StaticResource Pill}"
                                                                Margin="0,0,6,6"
                                                                Background="{DynamicResource ControlFillColorSecondaryBrush}">
                                                            <TextBlock Text="{Binding}"
                                                                       Style="{StaticResource PillText}"
                                                                       FontWeight="Normal"
                                                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>

                                        <!-- How much of this profile the machine already has. -->
                                        <Grid Margin="0,12,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <ProgressBar Value="{Binding CompletionPercent, Mode=OneWay}"
                                                         Maximum="100"
                                                         Height="4"
                                                         VerticalAlignment="Center"
                                                         Foreground="{Binding AccentColor, Converter={StaticResource HexToBrush}}" />

                                            <TextBlock Grid.Column="1" Margin="10,0,0,0" Style="{StaticResource CaptionText}">
                                                <Run Text="{Binding CompletionPercent, Mode=OneWay, StringFormat={}{0:F0}%}" />
                                                <Run Text="{loc:Loc Profiles_Applied}" />
                                            </TextBlock>
                                        </Grid>

                                        <ui:Button Content="{loc:Loc Profiles_Apply}"
                                                   Icon="{ui:SymbolIcon Play24}"
                                                   Appearance="Primary"
                                                   HorizontalAlignment="Stretch"
                                                   Margin="0,14,0,0"
                                                   Command="{Binding DataContext.ApplyCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                                   CommandParameter="{Binding}" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                </StackPanel>
            </Grid>
        </ScrollViewer>

        <ContentControl Template="{StaticResource BusyOverlayTemplate}" />
    </Grid>
</pages:SysTuneXPage>
