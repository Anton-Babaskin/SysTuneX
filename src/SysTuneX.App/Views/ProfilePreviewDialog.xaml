<UserControl x:Class="SysTuneX.App.Views.ProfilePreviewDialog"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:vm="clr-namespace:SysTuneX.App.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:ProfilePreviewViewModel}"
             MaxWidth="620">

    <!--
        Every registry value a profile would write, before it writes one. This used to be built
        control by control in C# inside the service that shows toasts; it is markup now, so what
        it looks like is here and what it says is in ProfilePreviewReport.
    -->
    <StackPanel>
        <ItemsControl ItemsSource="{Binding Captions}" Margin="0,0,0,12">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <TextBlock Text="{Binding Text}"
                               TextWrapping="Wrap"
                               Margin="0,0,0,2" />
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <ScrollViewer MaxHeight="320"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <ItemsControl ItemsSource="{Binding Entries}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <StackPanel>
                            <!-- A heading, which carries the risk of what follows it. -->
                            <TextBlock Text="{Binding Text}"
                                       TextWrapping="Wrap"
                                       FontWeight="SemiBold"
                                       Margin="0,10,0,4"
                                       Visibility="{Binding IsHeading, Converter={StaticResource BoolToVisibility}}" />

                            <!-- A detail line: a key and its two values, or a service and its two modes. -->
                            <TextBlock Text="{Binding Text}"
                                       TextWrapping="Wrap"
                                       Style="{StaticResource MonoText}"
                                       Opacity="0.85"
                                       Margin="0,0,0,2"
                                       Visibility="{Binding IsDetail, Converter={StaticResource BoolToVisibility}}" />
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <ui:InfoBar Severity="Informational"
                    Message="{Binding RestartNotice}"
                    IsOpen="True"
                    IsClosable="False"
                    Margin="0,12,0,0"
                    Visibility="{Binding NeedsRestartNotice, Converter={StaticResource BoolToVisibility}}" />

        <ui:InfoBar Severity="Warning"
                    Title="{Binding AdvancedTitle}"
                    Message="{Binding AdvancedNotice}"
                    IsOpen="True"
                    IsClosable="False"
                    Margin="0,8,0,0"
                    Visibility="{Binding HasAdvanced, Converter={StaticResource BoolToVisibility}}" />
    </StackPanel>
</UserControl>
